#!/bin/bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../../utils/bench"
FETCH_STARTED=$(bench_now)

EMPTY_CACHE_ECPU_PER_SECOND=30000
MINIMUM_METERED_STORAGE_BYTES=104857600

metric_config() {
  case "$1" in
  ElastiCacheProcessingUnits) echo "count Sum ElastiCacheProcessingUnits raw" ;;
  BytesUsedForCache) echo "bytes Maximum BytesUsedForCache raw" ;;
  CacheHitRate) echo "percent Average CacheHitRate raw" ;;
  CurrConnections) echo "count Maximum CurrConnections raw" ;;
  SuccessfulReadRequestLatency) echo "microseconds Average SuccessfulReadRequestLatency raw" ;;
  ThrottledCmds) echo "count Sum ThrottledCmds raw" ;;
  AvailableECPUPerSecond) echo "count Sum ElastiCacheProcessingUnits available_ecpu" ;;
  BilledDataStorage) echo "bytes Maximum BytesUsedForCache billed_storage" ;;
  *) return 1 ;;
  esac
}

iso_seconds_ago() {
  local seconds="$1" epoch
  epoch=$(($(date -u +%s) - seconds))
  date -u -d "@${epoch}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$epoch" +%Y-%m-%dT%H:%M:%SZ
}

require_timestamp() {
  local name="$1" value="$2"
  if [[ ! "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|\+00:00)$ ]]; then
    echo "ERROR: ${name} '${value}' is not a UTC ISO 8601 timestamp." >&2
    exit 1
  fi
}

cloudwatch_period() {
  local requested="$1"
  if [[ ! "$requested" =~ ^[0-9]+$ ]] || [ "$requested" -lt 60 ]; then
    echo 60
    return 0
  fi
  echo $(((requested + 59) / 60 * 60))
}

empty_series() {
  jq -n -c --arg metric "$1" --arg unit "$2" --argjson period "$3" \
    '{metric: $metric, type: "gauge", period_in_seconds: $period, unit: $unit, results: []}'
}

cache_usage_limits() {
  aws elasticache describe-serverless-caches \
    --region "$REGION" \
    --serverless-cache-name "$CACHE_NAME" \
    --output json | jq -c '.ServerlessCaches[0].CacheUsageLimits // {}'
}

ARGUMENTS=$(echo "$CONTEXT" | jq -c '.arguments // {}')
METRIC=$(echo "$ARGUMENTS" | jq -r '.metric // ""')
START_TIME=$(echo "$ARGUMENTS" | jq -r '.start_time // ""')
END_TIME=$(echo "$ARGUMENTS" | jq -r '.end_time // ""')
PERIOD=$(cloudwatch_period "$(echo "$ARGUMENTS" | jq -r '.period // ""')")

if ! CONFIG=$(metric_config "$METRIC"); then
  echo "ERROR: unknown metric '${METRIC}'." >&2
  exit 1
fi
read -r UNIT STATISTIC SOURCE_METRIC KIND <<<"$CONFIG"

if [ -z "$START_TIME" ] || [ -z "$END_TIME" ]; then
  START_TIME=$(iso_seconds_ago 3600)
  END_TIME=$(iso_seconds_ago 0)
fi
require_timestamp start_time "$START_TIME"
require_timestamp end_time "$END_TIME"

SERVICE_ATTRS=$(echo "$ARGUMENTS" | jq -c '.service.attributes // {}')

CACHE_NAME=$(echo "$SERVICE_ATTRS" | jq -r '.cache_name // ""')
REGION=$(echo "$SERVICE_ATTRS" | jq -r '.valkey_arn // "" | split(":") | .[3] // ""')

if [ -z "$CACHE_NAME" ] || [ -z "$REGION" ]; then
  RESULT=$(empty_series "$METRIC" "$UNIT" "$PERIOD")
  bench_log "fetch_metric: total (no cache yet, empty series)" "$FETCH_STARTED"
  echo "$RESULT"
  exit 0
fi

if [[ ! "$REGION" =~ ^[a-z]{2}(-[a-z]+)+-[0-9]+$ ]]; then
  echo "ERROR: '${REGION}' from the cache ARN is not an AWS region." >&2
  exit 1
fi

AWS_PROFILE_VAL=$(grep "^aws_profile:" "${VALUES:-/dev/null}" 2>/dev/null | sed 's/^[^:]*: *//;s/^"//;s/"$//' | head -1 || true)
if [ -n "$AWS_PROFILE_VAL" ]; then
  export AWS_PROFILE="$AWS_PROFILE_VAL"
fi

bench_log "fetch_metric: parse request (metric=${METRIC}, period=${PERIOD}s, ${START_TIME} to ${END_TIME})" "$FETCH_STARTED"

WORK_DIR=$(mktemp -d)
trap 'rm -f "$WORK_DIR"/*; rmdir "$WORK_DIR"' EXIT

AWS_STARTED=$(bench_now)

timed "fetch_metric: aws cloudwatch get-metric-statistics ${SOURCE_METRIC}" aws cloudwatch get-metric-statistics \
  --region "$REGION" \
  --namespace AWS/ElastiCache \
  --metric-name "$SOURCE_METRIC" \
  --dimensions "Name=clusterId,Value=${CACHE_NAME}" \
  --start-time "$START_TIME" \
  --end-time "$END_TIME" \
  --period "$PERIOD" \
  --statistics "$STATISTIC" \
  --output json >"$WORK_DIR/metric.json" 2>"$WORK_DIR/metric.err" &
METRIC_PID=$!

LIMITS_PID=""
if [ "$KIND" != "raw" ]; then
  timed "fetch_metric: aws elasticache describe-serverless-caches" cache_usage_limits >"$WORK_DIR/limits.json" 2>"$WORK_DIR/limits.err" &
  LIMITS_PID=$!
fi

if ! wait "$METRIC_PID"; then
  cat "$WORK_DIR/metric.err" >&2
  echo "ERROR: CloudWatch rejected the ${SOURCE_METRIC} query for ${CACHE_NAME} in ${REGION}." >&2
  exit 1
fi
RESPONSE=$(cat "$WORK_DIR/metric.json")

LIMITS='{}'
if [ -n "$LIMITS_PID" ]; then
  if ! wait "$LIMITS_PID"; then
    cat "$WORK_DIR/limits.err" >&2
    echo "ERROR: could not read the usage limits of ${CACHE_NAME} in ${REGION}." >&2
    exit 1
  fi
  LIMITS=$(cat "$WORK_DIR/limits.json")
fi
bench_log "fetch_metric: all aws calls done" "$AWS_STARTED"

BUILD_STARTED=$(bench_now)
RESULT=$(echo "$RESPONSE" | jq -c \
  --arg metric "$METRIC" \
  --arg unit "$UNIT" \
  --arg statistic "$STATISTIC" \
  --arg kind "$KIND" \
  --arg cache_name "$CACHE_NAME" \
  --arg start_time "$START_TIME" \
  --arg end_time "$END_TIME" \
  --argjson period "$PERIOD" \
  --argjson limits "$LIMITS" \
  --argjson empty_cache_ecpu "$EMPTY_CACHE_ECPU_PER_SECOND" \
  --argjson minimum_metered_bytes "$MINIMUM_METERED_STORAGE_BYTES" \
  '
  def epoch: sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601;
  def bucket: (. / $period | floor) * $period;
  def points: [(.Datapoints // [])[] | {epoch: (.Timestamp | epoch | bucket), value: .[$statistic]}];
  def series(derive):
    (points | map({key: (.epoch | tostring), value: .value}) | from_entries) as $used
    | [range($start_time | epoch | bucket; $end_time | epoch; $period)
       | {timestamp: todate, value: (($used[tostring] // 0) | derive)}];
  def ecpu_capacity: ($limits.ECPUPerSecond.Maximum // $empty_cache_ecpu);
  def storage_floor: ([$minimum_metered_bytes, (($limits.DataStorage.Minimum // 0) * 1073741824)] | max);
  {
    metric: $metric,
    type: "gauge",
    period_in_seconds: $period,
    unit: $unit,
    results: [{
      selector: {cache_name: $cache_name},
      data: (
        if $kind == "available_ecpu" then series([ecpu_capacity - (. / $period), 0] | max)
        elif $kind == "billed_storage" then series([., storage_floor] | max)
        else [(.Datapoints // [])[] | {timestamp: .Timestamp, value: .[$statistic]}] | sort_by(.timestamp)
        end
      )
    }]
  }')
bench_log "fetch_metric: build result (${#RESULT} bytes)" "$BUILD_STARTED"
bench_log "fetch_metric: total" "$FETCH_STARTED"

echo "$RESULT"
