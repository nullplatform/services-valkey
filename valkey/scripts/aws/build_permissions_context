#!/bin/bash
set -euo pipefail

yaml_value() {
  local key="$1" default="$2" file="$3"
  local val
  val=$(grep "^${key}:" "$file" 2>/dev/null | sed 's/^[^:]*: *//;s/^"//;s/"$//' | head -1)
  echo "${val:-$default}"
}

AWS_PROFILE_VAL=$(yaml_value "aws_profile" "" "$VALUES")
if [ -n "$AWS_PROFILE_VAL" ]; then
  export AWS_PROFILE="$AWS_PROFILE_VAL"
fi

if [ -z "${LINK_ID:-}" ]; then
  echo "ERROR: LINK_ID is not set. build_context must run before this script." >&2
  exit 1
fi

if [ -z "${CACHE_NAME:-}" ]; then
  echo "ERROR: CACHE_NAME is not set. build_context must run before this script." >&2
  exit 1
fi

if [ -z "${TFSTATE_KEY_PREFIX:-}" ]; then
  echo "ERROR: TFSTATE_KEY_PREFIX is not set. build_context must run before this script." >&2
  exit 1
fi

VALKEY_ARN=$(echo "$CONTEXT" | jq -r '.service.attributes.valkey_arn // ""')

if [ -z "$VALKEY_ARN" ]; then
  echo "ERROR: the service has no valkey_arn attribute yet." >&2
  echo "  The cache must be created before a link can be established." >&2
  exit 1
fi

# The user group the cache was created with, empty when it has no access control. Caches created
# before it was written to the service attributes all have a group of their own.
USER_GROUP_ID=$(echo "$CONTEXT" | jq -r --arg legacy "${CACHE_NAME}-ug" '.service.attributes | if has("link_user_group_id") then .link_user_group_id // "" else $legacy end')

# A public cache only accepts IAM-authenticated users; a VPC cache (and any cache created
# before the connection type existed) uses password users, unless it has no access control.
AUTH_MODE="password"
if [ -z "$USER_GROUP_ID" ]; then
  AUTH_MODE="none"
elif [ "$(echo "$CONTEXT" | jq -r '.service.attributes.connection_type // "vpc"')" = "public" ]; then
  AUTH_MODE="iam"
fi

echo "Link ${LINK_ID} -> cache ${CACHE_NAME} (user: ${LINK_USER_NAME})"

export OUTPUT_DIR="/tmp/np-link-${LINK_ID}"
mkdir -p "$OUTPUT_DIR"

export TOFU_MODULE_DIR="$SERVICE_PATH/permissions"

export TFSTATE_LINK_PREFIX="${TFSTATE_KEY_PREFIX}links/${LINK_ID}.tfstate"

export TOFU_INIT_VARIABLES="-backend-config=bucket=${TFSTATE_BUCKET} -backend-config=key=${TFSTATE_LINK_PREFIX} -backend-config=region=${REGION} -backend-config=use_lockfile=true"

export TOFU_VARIABLES="-var=link_id=${LINK_ID} -var=region=${REGION} -var=user_group_id=${USER_GROUP_ID} -var=user_name=${LINK_USER_NAME} -var=auth_mode=${AUTH_MODE} -var=cache_arn=${VALKEY_ARN}"
