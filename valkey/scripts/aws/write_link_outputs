#!/bin/bash
set -euo pipefail

cd "$OUTPUT_DIR"

LINK_ID=$(echo "$CONTEXT" | jq -r '.link.id')

OUTPUTS=$(tofu output -json 2>/dev/null || echo '{}')

USER_NAME=$(echo "$OUTPUTS"     | jq -r '.user_name.value     // ""')
AUTH_MODE=$(echo "$OUTPUTS"     | jq -r '.auth_mode.value     // "password"')
USER_PASSWORD=$(echo "$OUTPUTS" | jq -r '.user_password.value // ""')

ENDPOINT=$(echo "$CONTEXT" | jq -r '.service.attributes.endpoint // ""')
PORT=$(echo "$CONTEXT"     | jq -r '.service.attributes.port     // "6379"')

if [ -z "$USER_NAME" ]; then
  echo "ERROR: No user_name output found." >&2
  exit 1
fi

if [ -z "$ENDPOINT" ]; then
  echo "ERROR: the service has no endpoint attribute yet." >&2
  echo "  The link user exists but no connection url can be built for it." >&2
  exit 1
fi

if [ "$AUTH_MODE" = "iam" ]; then
  # A public cache: the application signs a short-lived IAM token with this access key and
  # sends it as the password, so the connection url carries none.
  ACCESS_KEY_ID=$(echo "$OUTPUTS"     | jq -r '.access_key_id.value     // ""')
  SECRET_ACCESS_KEY=$(echo "$OUTPUTS" | jq -r '.secret_access_key.value // ""')
  if [ -z "$ACCESS_KEY_ID" ] || [ -z "$SECRET_ACCESS_KEY" ]; then
    echo "ERROR: the IAM user was created but its access key could not be read." >&2
    echo "  Writing the link without it would hand the application credentials" >&2
    echo "  it cannot authenticate with." >&2
    exit 1
  fi

  AWS_REGION_VAL="${REGION:-$(echo "$CONTEXT" | jq -r '.service.attributes.aws_region // ""')}"
  CACHE_NAME_VAL=$(echo "$CONTEXT" | jq -r '.service.attributes.cache_name // ""')

  ATTRIBUTES=$(jq -n -c \
    --arg user_name         "$USER_NAME" \
    --arg access_key_id     "$ACCESS_KEY_ID" \
    --arg secret_access_key "$SECRET_ACCESS_KEY" \
    --arg aws_region        "$AWS_REGION_VAL" \
    --arg cache_name        "$CACHE_NAME_VAL" \
    --arg connection_url    "valkeys://${USER_NAME}@${ENDPOINT}:${PORT}" \
    '{
      user_name:         $user_name,
      access_key_id:     $access_key_id,
      secret_access_key: $secret_access_key,
      aws_region:        $aws_region,
      cache_name:        $cache_name,
      connection_url:    $connection_url
    }')
else
  if [ -z "$USER_PASSWORD" ]; then
    echo "ERROR: the user was created but its password could not be read." >&2
    echo "  Writing the link without it would hand the application credentials" >&2
    echo "  it cannot authenticate with." >&2
    exit 1
  fi

  CONNECTION_URL="valkeys://${USER_NAME}:${USER_PASSWORD}@${ENDPOINT}:${PORT}"

  ATTRIBUTES=$(jq -n -c \
    --arg user_name      "$USER_NAME" \
    --arg user_password  "$USER_PASSWORD" \
    --arg connection_url "$CONNECTION_URL" \
    '{
      user_name:      $user_name,
      user_password:  $user_password,
      connection_url: $connection_url
    }')
fi

echo "Writing link attributes for link ${LINK_ID} (user: ${USER_NAME})"

np link patch --id "$LINK_ID" --body "{\"attributes\": $ATTRIBUTES}"

echo "Link attributes updated."
