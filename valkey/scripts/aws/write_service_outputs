#!/bin/bash
set -euo pipefail

cd "$OUTPUT_DIR"

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id')

OUTPUTS=$(tofu output -json 2>/dev/null || echo '{}')

ENDPOINT=$(echo "$OUTPUTS"   | jq -r '.endpoint.value   // ""')
PORT=$(echo "$OUTPUTS"       | jq -r '.port.value       // ""')
VALKEY_ARN=$(echo "$OUTPUTS" | jq -r '.valkey_arn.value // ""')
CACHE_NAME=$(echo "$OUTPUTS" | jq -r '.cache_name.value // ""')
CONNECTION_TYPE=$(echo "$OUTPUTS" | jq -r '.connection_type.value // "vpc"')
USER_GROUP_ID=$(echo "$OUTPUTS" | jq -r '.user_group_id.value // ""')

if [ -z "$ENDPOINT" ]; then
  echo "WARNING: No endpoint output found. Skipping attribute update."
  exit 0
fi

ATTRIBUTES=$(jq -n -c \
  --arg endpoint   "$ENDPOINT" \
  --arg port       "$PORT" \
  --arg valkey_arn "$VALKEY_ARN" \
  --arg cache_name "$CACHE_NAME" \
  --arg connection_type "$CONNECTION_TYPE" \
  --arg link_user_group_id "$USER_GROUP_ID" \
  '{
    endpoint:   $endpoint,
    port:       $port,
    valkey_arn: $valkey_arn,
    cache_name: $cache_name,
    connection_type: $connection_type,
    link_user_group_id: $link_user_group_id
  }')

echo "Writing service attributes for service ${SERVICE_ID}:"
echo "$ATTRIBUTES" | jq .

np service patch --id "$SERVICE_ID" --body "{\"attributes\": $ATTRIBUTES}"

echo "Service attributes updated."
