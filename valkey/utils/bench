#!/bin/bash

exec 9>&2

if ! type -t bench_now >/dev/null 2>&1; then
  bench_now() {
    local now
    if [ -n "${EPOCHREALTIME:-}" ]; then
      now="${EPOCHREALTIME//[!0-9]/}"
      if [[ "$now" =~ ^[0-9]{16}$ ]]; then
        BENCH_CLOCK=epochrealtime
        echo $((10#$now / 1000))
        return 0
      fi
    fi
    now=$(date +%s%N 2>/dev/null || true)
    if [[ "$now" =~ ^[0-9]{19}$ ]]; then
      BENCH_CLOCK=date-nanoseconds
      echo $((10#$now / 1000000))
      return 0
    fi
    now=$(perl -MTime::HiRes=time -e 'printf "%d", time * 1000' 2>/dev/null || true)
    if [[ "$now" =~ ^[0-9]{13}$ ]]; then
      BENCH_CLOCK=perl
      echo "$now"
      return 0
    fi
    BENCH_CLOCK=seconds
    echo $(($(date +%s) * 1000))
  }
fi

if [ -z "${BENCH_START_MS:-}" ]; then
  BENCH_START_MS=$(bench_now)
  export BENCH_START_MS
fi

bench_log() {
  local label="$1" started="$2" now
  if [ "${VALKEY_BENCHMARK-true}" != "true" ]; then
    return 0
  fi
  bench_now >/dev/null
  now=$(bench_now)
  echo "[benchmark] $(date -u +%H:%M:%S) ${label}: $((now - started))ms (since start: $((now - BENCH_START_MS))ms, clock=${BENCH_CLOCK:-unknown})" >&9
}

timed() {
  local label="$1" started status
  shift
  started=$(bench_now)
  if "$@"; then
    status=0
  else
    status=$?
  fi
  bench_log "$label" "$started"
  return "$status"
}
